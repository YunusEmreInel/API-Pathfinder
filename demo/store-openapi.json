{
  "openapi": "3.0.3",
  "info": {
    "title": "Demo Store API",
    "version": "1.0.0",
    "description": "A small store API that ships with API Pathfinder for offline, repeatable demos."
  },
  "servers": [{ "url": "http://localhost:3000/demo-api" }],
  "paths": {
    "/products": {
      "get": {
        "operationId": "listProducts",
        "summary": "List products",
        "description": "Returns all products. Use the optional status filter to return only products that are on sale, in stock, or out of stock.",
        "tags": ["products"],
        "parameters": [{ "$ref": "#/components/parameters/ProductStatus" }],
        "responses": {
          "200": {
            "description": "A list of products.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProductList" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      },
      "post": {
        "operationId": "createProduct",
        "summary": "Create a product",
        "description": "Not supported by API Pathfinder v1 (GET only). Present to show that non-GET operations are skipped.",
        "responses": { "201": { "description": "Created" } }
      }
    },
    "/products/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/ProductId" }],
      "get": {
        "operationId": "getProductById",
        "summary": "Get a single product",
        "description": "Returns one product by its numeric ID, including name, price, category and sale status.",
        "tags": ["products"],
        "responses": {
          "200": {
            "description": "The product.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Product" } }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/categories": {
      "get": {
        "operationId": "listCategories",
        "summary": "List product categories",
        "description": "Returns the catalogue's categories (for example kitchen, books, outdoor, electronics).",
        "tags": ["categories"],
        "responses": {
          "200": {
            "description": "A list of categories.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/CategoryList" } }
            }
          }
        }
      }
    },
    "/orders": {
      "get": {
        "operationId": "listOrders",
        "summary": "List orders",
        "description": "Returns the authenticated customer's orders. Requires an API key, so API Pathfinder v1 will not execute it.",
        "tags": ["orders"],
        "security": [{ "ApiKeyAuth": [] }],
        "responses": { "200": { "description": "Orders." } }
      }
    }
  },
  "components": {
    "parameters": {
      "ProductStatus": {
        "name": "status",
        "in": "query",
        "required": false,
        "description": "Filter by sale status. on_sale = currently discounted / on sale.",
        "schema": { "type": "string", "enum": ["on_sale", "in_stock", "out_of_stock"] }
      },
      "ProductId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Numeric product ID.",
        "schema": { "type": "integer", "minimum": 1 }
      }
    },
    "schemas": {
      "Product": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "categoryId": { "type": "integer" },
          "price": { "type": "number" },
          "status": { "type": "string", "enum": ["on_sale", "in_stock", "out_of_stock"] }
        }
      },
      "ProductList": {
        "type": "object",
        "properties": {
          "count": { "type": "integer" },
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Product" } }
        }
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "slug": { "type": "string" }
        }
      },
      "CategoryList": {
        "type": "object",
        "properties": {
          "count": { "type": "integer" },
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Category" } }
        }
      },
      "Error": {
        "type": "object",
        "properties": { "error": { "type": "string" }, "message": { "type": "string" } }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid parameter.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "NotFound": {
        "description": "Resource not found.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": { "type": "apiKey", "in": "header", "name": "X-API-Key" }
    }
  }
}
