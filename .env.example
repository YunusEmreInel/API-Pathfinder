# Copy to .env.local and fill in. .env.local is ignored by git.

# PostgreSQL (must match docker-compose.yml, which reads the same POSTGRES_PASSWORD)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://pathfinder:change-me@localhost:5433/pathfinder

# Gemini — create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Must match the vector(N) column in db/init.sql
EMBEDDING_DIM=768

# Outbound request safety: only these exact origins may be called (comma-separated)
ALLOWED_API_ORIGINS=http://localhost:3000
REQUEST_TIMEOUT_MS=5000
MAX_RESPONSE_BYTES=65536
